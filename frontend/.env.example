# Copy to ".env.local". Every VITE_* value is PUBLIC (it is bundled into the browser code):
# never put passwords, database credentials or secret keys here.

# Where the Spring Boot API lives. Default if unset: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Optional "same-origin" mode: set VITE_API_BASE_URL= (empty) and the Vite dev server proxies /api to this target.
# VITE_PROXY_TARGET=http://localhost:8080
